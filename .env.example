# =============================================================================
# Resonance — environment variables
# Copy to .env and fill in only what you use. Never commit .env.
#
# Leave unused values EMPTY. A placeholder like "your_key_here" counts as a
# configured key: the setup wizard would not show and every LLM call would fail.
# Internal names keep the engine's codename (GEMA_*).
# =============================================================================

# --- LLM providers (all optional, all free tier; any one is enough) ---
# With none, sources are still read, scored and ranked. What stops working is
# parsing a free-text search, parsing a CV, and recovering a drifted scraper.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=

# First provider per task; the other six queue behind it (docs/LLM_PROVIDERS.md).
# LLM_PRIMARY_PARSE=mistral
# LLM_PRIMARY_AUDIT=gemini
# LLM_PRIMARY_EXTRACT=groq
# LLM_PRIMARY_PROFILE=cohere

# --- Candidate ---
# Drives the location policy (who can take a role from where).
PAIS_CANDIDATO=
IDIOMAS_QUE_HABLO=espanol,ingles

# --- Notifications (optional) ---
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Integrations (optional) ---
NOTION_API_KEY=
NOTION_DATABASE_ID=
GOOGLE_CREDENTIALS_PATH=credentials/google_service_account.json
GOOGLE_SHEET_ID=

# --- Gmail job alerts: LinkedIn and Indeed (off by default) ---
# Turn on only after `python tools/autorizar_gmail.py` and `--probar`.
GEMA_GMAIL_ALERTAS=0
GMAIL_TOKEN_PATH=credentials/gmail_token.json
GMAIL_CLIENT_SECRET_PATH=credentials/gmail_client_secret.json
GMAIL_ALERTAS_DIAS=4

# --- Storage ---
GEMA_DB_PATH=gema_registry.db
GEMA_BACKUP_DIR=backups
DEFAULT_TTL_HOURS=0

# --- Scheduler (UTC by default) ---
SCHEDULER_TIMEZONE=UTC
SCHEDULER_CRON_DAYS=tue,fri,sat
SCHEDULER_CRON_HOUR=9

# --- Browser scraper tuning ---
JITTER_MIN_SECONDS=5
JITTER_MAX_SECONDS=15
SCRAPER_CONCURRENCY=3
CIRCUIT_BREAKER_THRESHOLD=3
MAX_RATE_LIMIT_HITS=50
SRP_NULL_RATE_ALERT_THRESHOLD=0.4
