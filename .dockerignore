# =============================================================================
# .dockerignore — Project GEMA
# Files excluded from the Docker build context.
# Rule: if it's secret → exclude. If it's large and rebuilt in the image → exclude.
# If it's runtime state mounted as a volume → exclude.
# =============================================================================

# --- SECURITY: never bake secrets or credentials into the image ---
.env
.env.local
.env.*.local
credentials/*.json
credentials/*.p12
cookies/*.json          # manual cookie exports — mount via docker-compose volume
cookies/session/        # auto cookie jar (SessionJar) — runtime state, mounted rw

# --- LARGE BINARIES: downloaded/built during `docker build`, not copied ---
.camoufox/              # camoufox Firefox binary (~530MB) — built by `python -m camoufox fetch`
frontend/node_modules/  # ~hundreds of MB — Node stage runs `npm ci` fresh
frontend/dist/          # rebuilt by the Node stage; local copy would only go stale

# --- RUNTIME STATE: mounted as volumes, not baked in ---
*.db
*.db-shm
*.db-wal
*.bak

# --- GIT ---
.git/
.gitignore

# --- PYTHON ARTIFACTS ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.pytest_cache/

# --- TESTING: not needed in production image ---
tests/
pytest.ini

# --- DOCUMENTATION ---
*.md
!README.md

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- EXPORTS / GENERATED FILES ---
*.xlsx
*.csv
*.log
logs/

# --- PRIVATE FILES ---

LEEME_*.md







# --- ARCHIVES ---
*.zip
*.tar.gz
*.rar

# --- CLAUDE CODE ---
.claude/
